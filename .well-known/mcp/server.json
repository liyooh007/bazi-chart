{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.liyooh007/bazi-chart",
  "title": "bazi-chart",
  "description": "Chinese BaZi Four Pillars engine: precise solar terms, true-solar-time, lunar, patterns, offline.",
  "version": "1.2.0",
  "websiteUrl": "https://liyooh007.github.io/bazi-chart/demo.html",
  "repository": {
    "url": "https://github.com/liyooh007/bazi-chart",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "bazi-chart",
      "version": "1.2.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "bazi-mcp"
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tool": "manual",
      "version": "1.0.0",
      "tools": ["bazi_chart", "bazi_liunian", "bazi_liuyue", "bazi_lunar"],
      "license": "MIT",
      "offline": true,
      "language": ["zh-CN", "en"]
    }
  }
}
